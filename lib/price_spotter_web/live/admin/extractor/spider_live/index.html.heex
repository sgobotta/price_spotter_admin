<.header>
  <%= gettext("Extractors") %>
</.header>

<div
  :if={@load_error}
  class="my-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800 dark:bg-rose-900/30 dark:text-rose-300"
>
  <%= @load_error %>
</div>

<.list_group id="spiders" items={@spiders} class="my-4">
  <:empty_state>
    <.no_results_found label={gettext("No spiders found.")} />
  </:empty_state>
  <:row :let={spider}>
    <div class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:gap-4">
      <div class="flex items-center gap-3 sm:w-56 sm:shrink-0">
        <.entity_avatar label={spider.name} />
        <div class="min-w-0">
          <div class="truncate text-sm font-medium text-zinc-800 dark:text-zinc-200">
            <%= spider.name %>
          </div>
          <div class="truncate text-xs text-zinc-500 dark:text-zinc-400">
            <%= Extractor.humanize_cron(spider.cron) %>
          </div>
        </div>
      </div>

      <form
        id={"spiders-#{spider.name}-cron-form"}
        phx-submit="save_cron"
        class="flex items-center gap-2"
      >
        <input type="hidden" name="key" value={spider.name} />
        <.input
          type="text"
          name="cron"
          value={spider.cron}
          container_class="w-36"
        />
        <.button
          type="submit"
          class="bg-zinc-100 text-xs text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700"
        >
          <%= gettext("Save") %>
        </.button>
      </form>

      <button
        id={"spiders-#{spider.name}-toggle"}
        type="button"
        phx-click="toggle_active"
        phx-value-key={spider.name}
      >
        <.pill
          variant={if spider.active, do: :success, else: :neutral}
          text={
            if spider.active, do: gettext("Active"), else: gettext("Inactive")
          }
        />
      </button>

      <div class="flex flex-1 items-center justify-end gap-2">
        <.button
          id={"spiders-#{spider.name}-run"}
          type="button"
          phx-click="run"
          phx-value-key={spider.name}
          phx-value-dry_run="false"
          class="bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700"
        >
          <%= gettext("Run now") %>
        </.button>
        <.button
          :if={spider.supports_dry_run}
          id={"spiders-#{spider.name}-dry-run"}
          type="button"
          phx-click="run"
          phx-value-key={spider.name}
          phx-value-dry_run="true"
          class="bg-sky-100 text-sky-700 hover:bg-sky-200 dark:bg-sky-900/40 dark:text-sky-300 dark:hover:bg-sky-900/70"
        >
          <%= gettext("Dry run") %>
        </.button>
      </div>
    </div>
  </:row>
</.list_group>

<div
  :if={@active_run}
  id="active-run-panel"
  class="my-6 rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900"
>
  <div class="flex items-center justify-between">
    <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">
      <%= if @active_run.dry_run, do: gettext("Dry run"), else: gettext("Run") %> · <%= @active_run.spider_name %>
    </h3>
    <.pill
      variant={if @active_run.status == :finished, do: :neutral, else: :info}
      text={
        if @active_run.status == :finished,
          do: gettext("Finished"),
          else: gettext("Running")
      }
    />
  </div>

  <div
    id="run-log"
    phx-update="stream"
    class="mt-3 max-h-64 space-y-1 overflow-y-auto rounded-md bg-zinc-50 p-2 font-mono text-xs text-zinc-600 dark:bg-zinc-950 dark:text-zinc-300"
  >
    <div :for={{dom_id, entry} <- @streams.run_log} id={dom_id}>
      <%= run_log_line(entry) %>
    </div>
  </div>
</div>
