<div class="min-w-0 max-w-full">
  <div
    id="product-show-header"
    class="sticky top-0 z-40 -mx-4 mb-4 border-b border-zinc-200 bg-zinc-100 px-4 py-3 dark:border-zinc-700 dark:bg-zinc-800 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
  >
    <.header class="min-w-0">
      <span class="block truncate"><%= @product.name %></span>
      <:subtitle>
        <%= gettext(
          "Detailed view with current product metadata and price trend."
        ) %>
      </:subtitle>
      <:actions>
        <%= if Accounts.can_edit_products?(@current_user) do %>
          <.link
            id="edit-button"
            patch={~p"/admin/marketplaces/products/#{@product}/show/edit"}
            phx-click={JS.push_focus()}
          >
            <.button class="bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-600">
              <.icon name="hero-pencil-solid" class="h-4 w-4" />
              <span class="sr-only"><%= gettext("Edit Product") %></span>
            </.button>
          </.link>
        <% end %>
      </:actions>
      <:actions>
        <%= if Accounts.can_edit_products?(@current_user) do %>
          <.link
            id="delete-button"
            phx-click={
              JS.push("delete", value: %{id: @product.id})
              |> hide("##{@product.id}")
            }
            data-confirm={
              gettext("Delete product \"%{name}\"?", name: @product.name)
            }
          >
            <.button class="bg-rose-100 text-rose-700 hover:bg-rose-200 dark:bg-rose-900/40 dark:text-rose-300 dark:hover:bg-rose-900/70">
              <.icon name="hero-trash-solid" class="h-4 w-4" />
              <span class="sr-only"><%= gettext("Delete product") %></span>
            </.button>
          </.link>
        <% end %>
      </:actions>
    </.header>
  </div>

  <div id={@product.id} class="my-8 grid min-w-0 gap-6">
    <section class="min-w-0 max-w-full overflow-hidden rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900 sm:p-6">
      <div class="flex min-w-0 flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
        <div class="mx-auto h-40 w-40 shrink-0 overflow-hidden rounded-lg border border-zinc-200 bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 sm:mx-0 sm:h-44 sm:w-44">
          <img
            :if={@product.img_url != nil}
            src={@product.img_url}
            alt={gettext("%{name} image", name: @product.name)}
            class="h-full w-full object-contain"
          />
        </div>

        <dl
          id="product-details-list"
          class="min-w-0 w-full flex-1 divide-y divide-zinc-200 rounded-lg border border-zinc-200 dark:divide-zinc-700 dark:border-zinc-700"
        >
          <.detail_row id="product-detail-supplier" label={gettext("Supplier")}>
            <%= String.replace(@product.supplier_name, "-", " ") %>
          </.detail_row>

          <.detail_row id="product-detail-category" label={gettext("Category")}>
            <%= maybe_render_category(@product.category) %>
          </.detail_row>

          <.detail_row id="product-detail-price" label={gettext("Price")}>
            <%= if @product.price == nil do %>
              <%= gettext("No price yet") %>
            <% else %>
              <%= render_price(@product.price) %>
            <% end %>
          </.detail_row>

          <.detail_row id="product-detail-ean" label={gettext("EAN")}>
            <div class="flex items-center justify-end gap-2">
              <.render_ean
                ean={format_ean_string(@product.ean)}
                has_code={@product.ean != nil}
              />
              <input id="ean_code" type="hidden" value={@product.ean} />
              <span
                :if={@product.ean != nil}
                tabindex="0"
                id="copy-ean-code"
                data-to="#ean_code"
                phx-hook="Copy"
                phx-click="copy_ean"
                phx-window-keydown="copy_ean"
                phx-key="enter"
                class="cursor-pointer"
              >
                <%= if @copy_clicked do %>
                  <.icon
                    name="hero-clipboard-document-check"
                    class="h-5 w-5 text-teal-500"
                  />
                <% else %>
                  <.icon
                    name="hero-clipboard-document"
                    class="h-5 w-5 text-zinc-500 hover:text-blue-500 dark:text-zinc-400"
                  />
                <% end %>
              </span>
            </div>
          </.detail_row>

          <.detail_row
            id="product-detail-external-link"
            label={gettext("External link")}
          >
            <a
              :if={@product.supplier_url != nil}
              href={@product.supplier_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-zinc-600 hover:text-sky-500 dark:text-zinc-300"
            >
              <.icon name="hero-link-solid" class="h-4 w-4" />
              <%= gettext("Open") %>
            </a>
            <span
              :if={@product.supplier_url == nil}
              class="text-zinc-500 dark:text-zinc-400"
            >
              <%= gettext("Unavailable") %>
            </span>
          </.detail_row>

          <.detail_row
            :for={entry <- product_meta_rows(@product.meta)}
            id={entry.id}
            label={entry.label}
          >
            <%= entry.value %>
          </.detail_row>
        </dl>
      </div>
    </section>

    <section class="min-w-0 max-w-full overflow-hidden rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900 sm:p-6">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-300">
          <%= gettext("Price history") %>
        </h2>
        <span class="text-xs italic text-zinc-500 dark:text-zinc-400">
          <%= gettext("Last price") %>: <%= TimeAgo.time_ago(
            @product.price_updated_at
          ) %>
        </span>
      </div>

      <div class="mb-4 rounded-lg border border-zinc-200 p-1 dark:border-zinc-700">
        <div
          class="grid grid-cols-3 gap-1"
          role="group"
          aria-label={gettext("Price history")}
        >
          <button
            type="button"
            aria-pressed={to_string(@interval == :daily)}
            class={[
              "segmented-control-tab rounded-md px-2 py-1 text-sm",
              @interval == :daily && "is-selected"
            ]}
            phx-click="interval_change"
            phx-value-interval={:daily}
          >
            <%= gettext("Daily") %>
          </button>
          <button
            type="button"
            aria-pressed={to_string(@interval == :weekly)}
            class={[
              "segmented-control-tab rounded-md px-2 py-1 text-sm",
              @interval == :weekly && "is-selected"
            ]}
            phx-click="interval_change"
            phx-value-interval={:weekly}
          >
            <%= gettext("Weekly") %>
          </button>
          <button
            type="button"
            aria-pressed={to_string(@interval == :monthly)}
            class={[
              "segmented-control-tab rounded-md px-2 py-1 text-sm",
              @interval == :monthly && "is-selected"
            ]}
            phx-click="interval_change"
            phx-value-interval={:monthly}
          >
            <%= gettext("Monthly") %>
          </button>
        </div>
      </div>

      <div class="relative h-96 w-full min-w-0 max-w-full overflow-hidden">
        <%= render_chart(@socket) %>
      </div>
    </section>
  </div>

  <section
    :if={has_ean_listings?(@ean_listings)}
    id="ean-listings"
    class="mb-8 min-w-0 max-w-full overflow-hidden rounded-lg border border-sky-200 bg-sky-50 p-4 dark:border-sky-900 dark:bg-sky-950/40 sm:p-6"
  >
    <div class="mb-4 flex items-start gap-3">
      <.icon
        name="hero-building-storefront"
        class="mt-0.5 h-5 w-5 shrink-0 text-sky-600 dark:text-sky-300"
      />
      <div>
        <h2 class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
          <%= gettext("Same product at other suppliers") %>
        </h2>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
          <%= gettext("This EAN is also listed by other suppliers.") %>
        </p>
      </div>
    </div>

    <ul
      :if={@ean_listings.visible != []}
      id="ean-listings-visible"
      class="divide-y divide-sky-200 rounded-lg border border-sky-200 bg-white dark:divide-sky-900 dark:border-sky-900 dark:bg-zinc-900"
    >
      <li
        :for={listing <- @ean_listings.visible}
        id={"ean-listing-#{listing.id}"}
        class="flex items-center gap-3 p-3 sm:p-4"
      >
        <div class="h-16 w-16 shrink-0 overflow-hidden rounded-md bg-zinc-100 dark:bg-zinc-800">
          <img
            :if={listing.img_url != nil}
            src={listing.img_url}
            alt={gettext("%{name} image", name: listing.name)}
            class="h-full w-full object-contain"
          />
        </div>

        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
          <.pill
            text={String.replace(listing.supplier_name, "-", " ")}
            variant={:danger}
          />
          <.pill
            :if={listing.category != nil}
            text={maybe_render_category(listing.category)}
            variant={:info}
          />
          <span
            :for={entry <- product_meta_rows(listing.meta)}
            id={"ean-listing-#{listing.id}-#{entry.id}"}
            class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
          >
            <span class="font-medium"><%= entry.label %></span>
            <span><%= entry.value %></span>
          </span>
          <a
            href={~p"/admin/marketplaces/products/#{listing}/show"}
            target="_blank"
            rel="noopener noreferrer"
            title={listing.name}
            class="inline-flex items-center justify-center rounded-lg p-2 text-zinc-600 hover:bg-zinc-100 hover:text-sky-600 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-sky-300"
          >
            <.icon name="hero-shopping-cart-solid" class="h-4 w-4" />
            <span class="sr-only"><%= gettext("Open listing") %></span>
          </a>
        </div>

        <div class="shrink-0 text-right">
          <div class="text-sm font-semibold text-zinc-700 dark:text-zinc-200">
            <%= if listing.price == nil do %>
              <%= gettext("No price yet") %>
            <% else %>
              <%= render_price(listing.price) %>
            <% end %>
          </div>
          <div
            :if={delta = price_delta(listing.price, @product.price)}
            id={"ean-listing-#{listing.id}-delta"}
            class={[
              "text-xs font-medium",
              delta.cmp == :lt && "text-rose-600 dark:text-rose-400",
              delta.cmp == :gt && "text-emerald-600 dark:text-emerald-400",
              delta.cmp == :eq && "text-zinc-500 dark:text-zinc-400"
            ]}
          >
            <%= delta.label %>
          </div>
          <p
            class="mt-1 text-xs italic text-zinc-500 dark:text-zinc-400"
            title={gettext("Last price update")}
          >
            <%= TimeAgo.time_ago(listing.price_updated_at) %>
          </p>
        </div>
      </li>
    </ul>

    <p
      :if={@ean_listings.hidden_supplier_count > 0}
      id="ean-listings-hidden-count"
      class="mt-3 text-sm text-zinc-600 dark:text-zinc-400"
    >
      <%= if @ean_listings.visible != [] do %>
        <%= ngettext(
          "%{count} more supplier sells this product",
          "%{count} more suppliers sell this product",
          @ean_listings.hidden_supplier_count,
          count: @ean_listings.hidden_supplier_count
        ) %>
      <% else %>
        <%= ngettext(
          "%{count} other supplier sells this product",
          "%{count} other suppliers sell this product",
          @ean_listings.hidden_supplier_count,
          count: @ean_listings.hidden_supplier_count
        ) %>
      <% end %>
    </p>
  </section>

  <.back navigate={~p"/admin/marketplaces/products"}>
    <%= gettext("Back to products") %>
  </.back>

  <.modal
    :if={@live_action == :edit}
    id="product-modal"
    show
    on_cancel={JS.patch(~p"/admin/marketplaces/products/#{@product}/show")}
  >
    <.live_component
      module={PriceSpotterWeb.Admin.Marketplaces.ProductLive.FormComponent}
      id={@product.id}
      title={@page_title}
      action={@live_action}
      product={@product}
      patch={~p"/admin/marketplaces/products/#{@product}/show"}
    />
  </.modal>
</div>
