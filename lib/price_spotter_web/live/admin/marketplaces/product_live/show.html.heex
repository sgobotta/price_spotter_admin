<.header>
  <:actions>
    <%= if Accounts.can_edit_products?(@current_user) do %>
      <.link
        phx-click={
          JS.push("delete", value: %{id: @product.id})
          |> hide("##{@product.id}")
        }
        data-confirm={
          gettext("Delete product \"%{name}\"?", name: @product.name)
        }
        class=""
      >
        <.button class="bg-rose-500 hover:bg-rose-400">
          <%= gettext("Delete product") %>
          <span>
            <.icon name="hero-trash-solid" class="h-5 w-5 opacity-60" />
          </span>
        </.button>
      </.link>
    <% end %>
  </:actions>
  <:actions>
    <%= if Accounts.can_edit_products?(@current_user) do %>
      <.link
        id="edit-button"
        patch={~p"/admin/marketplaces/products/#{@product}/show/edit"}
        phx-click={JS.push_focus()}
      >
        <.button><%= gettext("Edit Product") %></.button>
      </.link>
    <% end %>
  </:actions>
</.header>

<div
  id={@product.id}
  class="p-4 xs:w-full sm:w-2/3 md:w-2/3 lg:w-1/2 xl:w-1/3 w-full cursor-default"
>
  <div
    class="p-4 rounded-lg card-bg shadow-zinc-500 dark:shadow-zinc-500 shadow-md duration-500
    border-zinc-300 dark:border-zinc-700 border-[1px]"
    id={"products-#{@product.id}-card"}
  >
    <div class="flex items-center justify-between">
      <div class="text-left w-full">
        <h2 class="text-gray-900 dark:text-gray-100 text-lg font-bold border-b border-orange-500">
          <%= @product.name %>
        </h2>
        <h3 class="mt-2 text-xl font-bold text-orange-500 text-left cursor-text">
        </h3>
        <li class="flex border-0 py-1 border-dashed border-b-zinc-200 dark:border-b-zinc-700 items-center justify-between">
          <div class="md:w-1/3 grid place-items-center">
            <img src={@product.img_url} class="rounded-lg" />
          </div>

          <div class="
            bg-gradient-to-tr
            from-zinc-400/75 to-zinc-300/75
            dark:from-zinc-400 dark:to-zinc-300
            w-32 h-32
            rounded-full
            shadow-2xl shadow-zinc-400/50
            group-hover:shadow-lg
            border-zinc-400 border-dashed border-2
            group-hover:-rotate-180 duration-1000 group-hover:border-dotted group-hover:border-[1px]
            flex justify-center items-center
          ">
            <div>
              <h1 class="text-white dark:text-white text-2xl">
                <%= render_price(@product.price) %>
              </h1>
            </div>
          </div>
        </li>
        <li class="flex border-b py-1 border-dashed border-b-zinc-200 dark:border-b-zinc-700 justify-between">
          <span class="text-gray-600 dark:text-gray-400 font-medium w-1/2 md:w-1/3 self-center">
            <%= gettext("Supplier") %>
          </span>
          <span class="">
            <div class="bg-red-200 border-[1px] border-red-100 px-3 py-1 rounded-full text-xs font-medium text-gray-800 md:block text-center shadow-inner-lg">
              <%= String.replace(@product.supplier_name, "-", " ") %>
            </div>
          </span>
        </li>
        <li class="flex border-b py-1 border-dashed border-b-zinc-200 dark:border-b-zinc-700 justify-between">
          <span class="text-gray-600 dark:text-gray-400 font-medium w-1/2 md:w-1/3 self-center">
            <%= gettext("Category") %>
          </span>
          <span class="">
            <div class="bg-blue-200 border-[1px] border-blue-100 px-3 py-1 rounded-full text-xs font-medium text-gray-500 md:block text-center shadow-inner-lg">
              <%= String.replace(@product.category, "-", " ") %>
            </div>
          </span>
        </li>
        <li class="flex border-b py-1 border-dashed border-b-zinc-200 dark:border-b-zinc-700 justify-between">
          <div>
            <span class="text-gray-600 dark:text-gray-400 font-medium w-1/2 md:w-1/3 self-center">
              <%= gettext("EAN") %>
            </span>
          </div>
          <div id="ean-code">
            <.render_ean
              ean={format_ean_string(@product.ean)}
              has_code={@product.ean !== nil}
            />
            <input id="#ean_code" type="hidden" value={@product.ean} />
          </div>
          <%= if @product.ean do %>
            <div>
              <span
                tabindex="0"
                id="copy-ean-code"
                data-to="#ean_code"
                phx-hook="Copy"
                phx-click="copy_ean"
                phx-window-keydown="copy_ean"
                phx-key="enter"
              >
                <%= if @copy_clicked do %>
                  <.icon
                    name="hero-clipboard-document-check"
                    class="text-teal-500 dark:text-teal-500 h-5 w-5"
                  />
                <% else %>
                  <.icon
                    name="hero-clipboard-document"
                    class="text-gray-900 dark:text-gray-100 h-5 w-5 hover:text-blue-500"
                  />
                <% end %>
              </span>
            </div>
          <% end %>
        </li>
        <li class="flex border-b py-1 border-dashed border-b-zinc-200 dark:border-b-zinc-700 justify-end">
          <a
            href={@product.supplier_url}
            target="_blank"
            class="hover:text-sky-500 hover:opacity-100 text-gray-600 dark:text-gray-400 italic text-sm"
          >
            <.icon name="hero-link-solid" class="h-4 w-4 opacity-60" />
            <span class="">
              <%= gettext("External link") %>
            </span>
          </a>
        </li>
      </div>
    </div>
    <div class="my-4 flex justify-end">
      <p class="text-sm italic text-gray-600 dark:text-gray-400 text-left">
        <%= gettext("Last price") %>: <%= TimeAgo.time_ago(
          @product.price_updated_at
        ) %>
      </p>
    </div>
    <div class="w-full cursor-default mt-4">
      <div class="inline-flex w-full justify-evenly font-normal text-zinc-600 dark:text-zinc-400">
        <button
          class={"
            #{if @interval == :daily,
              do: "text-base text-zinc-500 font-semibold",
              else: "text-sm hover:text-zinc-500 hover:dark:text-zinc-500 transition-colors duration-500"
              }
          "}
          phx-click="interval_change"
          phx-value-interval={:daily}
        >
          <%= gettext("Daily") %>
        </button>
        <button
          class={"
            #{if @interval == :weekly,
              do: "text-base text-zinc-500 font-semibold",
              else: "text-sm hover:text-zinc-500 hover:dark:text-zinc-500 transition-colors duration-500"
              }
          "}
          phx-click="interval_change"
          phx-value-interval={:weekly}
        >
          <%= gettext("Weekly") %>
        </button>
        <button
          class={"
            #{if @interval == :monthly,
              do: "text-base text-zinc-500 font-semibold",
              else: "text-sm hover:text-zinc-500 hover:dark:text-zinc-500 transition-colors duration-500"
              }
          "}
          phx-click="interval_change"
          phx-value-interval={:monthly}
        >
          <%= gettext("Monthly") %>
        </button>
      </div>
      <%= render_chart(@socket) %>
    </div>
  </div>
</div>

<.back navigate={~p"/admin/marketplaces/products"}>
  <%= gettext("Back to products") %>
</.back>

<.modal
  :if={@live_action == :edit}
  id="product-modal"
  show
  on_cancel={JS.patch(~p"/admin/marketplaces/products/#{@product}")}
>
  <.live_component
    module={PriceSpotterWeb.Admin.Marketplaces.ProductLive.FormComponent}
    id={@product.id}
    title={@page_title}
    action={@live_action}
    product={@product}
    patch={~p"/admin/marketplaces/products/#{@product}"}
  />
</.modal>
