<div class="xl:mx-32">
  <div class="my-4">
    <.header>
      <%= @product.name %>
      <:subtitle>
        <%= gettext(
          "Detailed view with current product metadata and price trend."
        ) %>
      </:subtitle>
      <:actions>
        <%= if Accounts.can_edit_products?(@current_user) do %>
          <.link
            id="edit-button"
            patch={~p"/admin/marketplaces/products/#{@product}/show/edit"}
            phx-click={JS.push_focus()}
          >
            <.button class="bg-zinc-700 text-zinc-100 hover:bg-zinc-600 dark:bg-zinc-200 dark:text-zinc-900 dark:hover:bg-zinc-300">
              <%= gettext("Edit Product") %>
            </.button>
          </.link>
        <% end %>
      </:actions>
      <:actions>
        <%= if Accounts.can_edit_products?(@current_user) do %>
          <.link
            phx-click={
              JS.push("delete", value: %{id: @product.id})
              |> hide("##{@product.id}")
            }
            data-confirm={
              gettext("Delete product \"%{name}\"?", name: @product.name)
            }
          >
            <.button class="bg-rose-500 text-zinc-100 hover:bg-rose-400">
              <%= gettext("Delete product") %>
              <.icon name="hero-trash-solid" class="ml-1 h-4 w-4" />
            </.button>
          </.link>
        <% end %>
      </:actions>
    </.header>
  </div>

  <div id={@product.id} class="my-8 grid gap-6 lg:grid-cols-3">
    <section class="rounded-lg border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-900 lg:col-span-2">
      <div class="flex flex-col gap-3 border-b border-zinc-200 p-4 dark:border-zinc-700 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="text-sm text-zinc-500 dark:text-zinc-400">
          <%= gettext("Product information") %>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <.pill
            text={String.replace(@product.supplier_name, "-", " ")}
            variant={:danger}
          />
          <.pill
            text={maybe_render_category(@product.category)}
            variant={:info}
          />
          <.pill
            text={
              if @product.price == nil,
                do: gettext("No price yet"),
                else: render_price(@product.price)
            }
            variant={if @product.price == nil, do: :warning, else: :success}
          />
        </div>
      </div>

      <div class="grid gap-6 p-4 sm:p-6 md:grid-cols-2">
        <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-700 dark:bg-zinc-800/60">
          <div class="aspect-square w-full overflow-hidden rounded-lg bg-zinc-200 dark:bg-zinc-800">
            <img
              :if={@product.img_url != nil}
              src={@product.img_url}
              alt={gettext("%{name} image", name: @product.name)}
              class="h-full w-full object-cover"
            />
          </div>
        </div>

        <dl class="divide-y divide-zinc-200 rounded-lg border border-zinc-200 dark:divide-zinc-700 dark:border-zinc-700">
          <div class="flex items-center justify-between gap-4 p-3 sm:p-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              <%= gettext("Supplier") %>
            </dt>
            <dd class="text-sm text-zinc-700 dark:text-zinc-200">
              <%= String.replace(@product.supplier_name, "-", " ") %>
            </dd>
          </div>

          <div class="flex items-center justify-between gap-4 p-3 sm:p-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              <%= gettext("Category") %>
            </dt>
            <dd class="text-sm text-zinc-700 dark:text-zinc-200">
              <%= maybe_render_category(@product.category) %>
            </dd>
          </div>

          <div class="flex items-center justify-between gap-4 p-3 sm:p-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              <%= gettext("Price") %>
            </dt>
            <dd class="text-sm text-zinc-700 dark:text-zinc-200">
              <%= if @product.price == nil do %>
                <%= gettext("No price yet") %>
              <% else %>
                <%= render_price(@product.price) %>
              <% end %>
            </dd>
          </div>

          <div class="flex items-center justify-between gap-4 p-3 sm:p-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              <%= gettext("EAN") %>
            </dt>
            <dd class="flex items-center gap-2 text-sm text-zinc-700 dark:text-zinc-200">
              <.render_ean
                ean={format_ean_string(@product.ean)}
                has_code={@product.ean != nil}
              />
              <input id="ean_code" type="hidden" value={@product.ean} />
              <span
                :if={@product.ean != nil}
                tabindex="0"
                id="copy-ean-code"
                data-to="#ean_code"
                phx-hook="Copy"
                phx-click="copy_ean"
                phx-window-keydown="copy_ean"
                phx-key="enter"
                class="cursor-pointer"
              >
                <%= if @copy_clicked do %>
                  <.icon
                    name="hero-clipboard-document-check"
                    class="h-5 w-5 text-teal-500"
                  />
                <% else %>
                  <.icon
                    name="hero-clipboard-document"
                    class="h-5 w-5 text-zinc-500 hover:text-blue-500 dark:text-zinc-400"
                  />
                <% end %>
              </span>
            </dd>
          </div>

          <div class="flex items-center justify-between gap-4 p-3 sm:p-4">
            <dt class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
              <%= gettext("External link") %>
            </dt>
            <dd class="text-sm">
              <a
                :if={@product.supplier_url != nil}
                href={@product.supplier_url}
                target="_blank"
                class="inline-flex items-center gap-1 text-zinc-600 hover:text-sky-500 dark:text-zinc-300"
              >
                <.icon name="hero-link-solid" class="h-4 w-4" />
                <%= gettext("Open") %>
              </a>
              <span
                :if={@product.supplier_url == nil}
                class="text-zinc-500 dark:text-zinc-400"
              >
                <%= gettext("Unavailable") %>
              </span>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900 sm:p-6">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-600 dark:text-zinc-300">
          <%= gettext("Price history") %>
        </h2>
        <span class="text-xs italic text-zinc-500 dark:text-zinc-400">
          <%= gettext("Last price") %>: <%= TimeAgo.time_ago(
            @product.price_updated_at
          ) %>
        </span>
      </div>

      <div class="mb-4 rounded-lg border border-zinc-200 p-1 dark:border-zinc-700">
        <div class="grid grid-cols-3 gap-1">
          <button
            class={[
              "rounded-md px-2 py-1 text-sm transition-colors",
              if(@interval == :daily,
                do:
                  "bg-zinc-200 font-semibold text-zinc-800 dark:bg-zinc-700 dark:text-zinc-100",
                else:
                  "text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
              )
            ]}
            phx-click="interval_change"
            phx-value-interval={:daily}
          >
            <%= gettext("Daily") %>
          </button>
          <button
            class={[
              "rounded-md px-2 py-1 text-sm transition-colors",
              if(@interval == :weekly,
                do:
                  "bg-zinc-200 font-semibold text-zinc-800 dark:bg-zinc-700 dark:text-zinc-100",
                else:
                  "text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
              )
            ]}
            phx-click="interval_change"
            phx-value-interval={:weekly}
          >
            <%= gettext("Weekly") %>
          </button>
          <button
            class={[
              "rounded-md px-2 py-1 text-sm transition-colors",
              if(@interval == :monthly,
                do:
                  "bg-zinc-200 font-semibold text-zinc-800 dark:bg-zinc-700 dark:text-zinc-100",
                else:
                  "text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
              )
            ]}
            phx-click="interval_change"
            phx-value-interval={:monthly}
          >
            <%= gettext("Monthly") %>
          </button>
        </div>
      </div>

      <div class="h-64 w-full">
        <%= render_chart(@socket) %>
      </div>
    </section>
  </div>

  <.back navigate={~p"/admin/marketplaces/products"}>
    <%= gettext("Back to products") %>
  </.back>

  <.modal
    :if={@live_action == :edit}
    id="product-modal"
    show
    on_cancel={JS.patch(~p"/admin/marketplaces/products/#{@product}")}
  >
    <.live_component
      module={PriceSpotterWeb.Admin.Marketplaces.ProductLive.FormComponent}
      id={@product.id}
      title={@page_title}
      action={@live_action}
      product={@product}
      patch={~p"/admin/marketplaces/products/#{@product}"}
    />
  </.modal>
</div>
