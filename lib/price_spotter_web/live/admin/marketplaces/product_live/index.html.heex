<div class="xl:mx-32">
  <div class="my-4">
    <.header>
      <:actions>
        <%= if Accounts.can_create_products?(@current_user) do %>
          <.link patch={~p"/admin/marketplaces/products/new"}>
            <.button><%= gettext("New Product") %></.button>
          </.link>
        <% end %>

        <div class="flex justify-end mb-2 rounded-lg">
          <.dropdown id="product-filters-dropdown">
            <:toggle>
              <%= gettext("Export") %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="currentColor"
                class="w-6 h-6 ml-1"
                viewBox="0 0 16 16"
              >
                <path
                  fill-rule="evenodd"
                  d="M14 4.5V14a2 2 0 0 1-2 2h-1v-1h1a1 1 0 0 0 1-1V4.5h-2A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v9H2V2a2 2 0 0 1 2-2h5.5L14 4.5ZM3.517 14.841a1.13 1.13 0 0 0 .401.823c.13.108.289.192.478.252.19.061.411.091.665.091.338 0 .624-.053.859-.158.236-.105.416-.252.539-.44.125-.189.187-.408.187-.656 0-.224-.045-.41-.134-.56a1.001 1.001 0 0 0-.375-.357 2.027 2.027 0 0 0-.566-.21l-.621-.144a.97.97 0 0 1-.404-.176.37.37 0 0 1-.144-.299c0-.156.062-.284.185-.384.125-.101.296-.152.512-.152.143 0 .266.023.37.068a.624.624 0 0 1 .246.181.56.56 0 0 1 .12.258h.75a1.092 1.092 0 0 0-.2-.566 1.21 1.21 0 0 0-.5-.41 1.813 1.813 0 0 0-.78-.152c-.293 0-.551.05-.776.15-.225.099-.4.24-.527.421-.127.182-.19.395-.19.639 0 .201.04.376.122.524.082.149.2.27.352.367.152.095.332.167.539.213l.618.144c.207.049.361.113.463.193a.387.387 0 0 1 .152.326.505.505 0 0 1-.085.29.559.559 0 0 1-.255.193c-.111.047-.249.07-.413.07-.117 0-.223-.013-.32-.04a.838.838 0 0 1-.248-.115.578.578 0 0 1-.255-.384h-.765ZM.806 13.693c0-.248.034-.46.102-.633a.868.868 0 0 1 .302-.399.814.814 0 0 1 .475-.137c.15 0 .283.032.398.097a.7.7 0 0 1 .272.26.85.85 0 0 1 .12.381h.765v-.072a1.33 1.33 0 0 0-.466-.964 1.441 1.441 0 0 0-.489-.272 1.838 1.838 0 0 0-.606-.097c-.356 0-.66.074-.911.223-.25.148-.44.359-.572.632-.13.274-.196.6-.196.979v.498c0 .379.064.704.193.976.131.271.322.48.572.626.25.145.554.217.914.217.293 0 .554-.055.785-.164.23-.11.414-.26.55-.454a1.27 1.27 0 0 0 .226-.674v-.076h-.764a.799.799 0 0 1-.118.363.7.7 0 0 1-.272.25.874.874 0 0 1-.401.087.845.845 0 0 1-.478-.132.833.833 0 0 1-.299-.392 1.699 1.699 0 0 1-.102-.627v-.495Zm8.239 2.238h-.953l-1.338-3.999h.917l.896 3.138h.038l.888-3.138h.879l-1.327 4Z"
                />
              </svg>
            </:toggle>
            <ul class="mt-1 border border-zinc-300 dark:border-zinc-600 shadow-outer-md menu bg-zinc-100 dark:bg-zinc-800 border-base-300 w-64 rounded-b-md rounded-md">
              <li>
                <div class="py-3">
                  <div class="px-1">
                    <.form
                      :let={f}
                      for={@filter_fields_form}
                      action={
                        PriceSpotterWeb.Router.Helpers.export_path(
                          PriceSpotterWeb.Endpoint,
                          :create
                        )
                      }
                      method="get"
                      target="_blank"
                    >
                      <.input
                        type="hidden"
                        field={f[:columns]}
                        value={get_column_names()}
                        class="gap-y-4"
                        checked={true}
                      />

                      <div class="border-b-1 border-zinc-300 dark:border-zinc-700 mb-2 text-zinc-500 text-sm pb-2 cursor-default">
                        <h3 class="text-sm pl-2">
                          <%= gettext("Export") %>
                        </h3>
                      </div>

                      <%= for %{name: name, label: label} <- get_columns() do %>
                        <div class="p-1 hover:bg-zinc-200 hover:dark:bg-zinc-800 rounded-md">
                          <.input
                            type="checkbox"
                            field={f[name]}
                            label={label}
                            class="gap-y-4 p-1 cursor-default"
                            checked={true}
                          />
                        </div>
                      <% end %>

                      <.input
                        type="hidden"
                        field={f[:first]}
                        value={get_limit()}
                        class="gap-y-4"
                      />

                      <div class="border-b-1 border-zinc-300 dark:border-zinc-700 my-2" />

                      <div class="p-1">
                        <.input
                          type="checkbox"
                          field={f[:all_pages]}
                          label={gettext("Export all pages?")}
                          class="gap-y-4 text-xs"
                        />
                      </div>

                      <.input
                        type="hidden"
                        field={f[:max_limit]}
                        value={get_max_limit()}
                        class="gap-y-4"
                      />

                      <div class="mt-2 mx-2">
                        <.button class="w-full" type="submit">
                          <%= gettext("Export") %>
                        </.button>
                      </div>
                    </.form>
                  </div>
                </div>
              </li>
            </ul>
          </.dropdown>
        </div>
      </:actions>
    </.header>
  </div>

  <div>
    <.filter_form
      id="products-filter-form"
      meta={@meta}
      fields={@filter_fields}
    />
  </div>

  <div class="my-8">
    <%= if @products && @meta do %>
      <.list_header meta={@meta} path={~p"/admin/marketplaces/products"}>
        <:col field={:name} label={gettext("Product")} class="shrink-0" />
        <:col
          field={:supplier_name}
          label={gettext("Supplier")}
          class="shrink-0"
        />
        <:col
          field={:price_updated_at}
          label={gettext("Last updated")}
          class="ml-auto w-52 shrink-0 whitespace-nowrap"
        />
        <:col
          field={:price}
          label={gettext("Last Price")}
          class="w-36 shrink-0 whitespace-nowrap"
        />
        <:col class="w-4 shrink-0"></:col>
      </.list_header>

      <.list_group id="products" items={@products}>
        <:empty_state>
          <.no_results_found label={gettext("No products found.")} />
        </:empty_state>
        <:row :let={product}>
          <.expandable_list_row
            id={"products-#{product.id}"}
            expanded={expanded_product?(@expanded, product.id)}
            toggle_key={product.id}
            toggle_patch={
              toggle_expand_path(
                product,
                @current_user,
                @expanded,
                @meta
              )
            }
            content_class="flex flex-col gap-3"
          >
            <:leading>
              <.entity_avatar label={product.name} />
            </:leading>
            <:title>
              <span class="block min-w-0 truncate"><%= product.name %></span>
            </:title>
            <:subtitle>
              <div class="flex min-w-0 flex-wrap items-center gap-1">
                <.pill
                  text={String.replace(product.supplier_name, "-", " ")}
                  variant={:danger}
                />
                <.pill
                  :if={product.category != nil}
                  text={maybe_render_category(product.category)}
                  variant={:info}
                />
              </div>
            </:subtitle>
            <:meta :if={!expanded_product?(@expanded, product.id)}>
              <span class="flex w-52 shrink-0 items-center whitespace-nowrap text-xs text-zinc-500 dark:text-zinc-400">
                <%= TimeAgo.time_ago(product.price_updated_at) %>
              </span>
              <span class="flex w-36 shrink-0 items-center">
                <.pill
                  text={product_price(product.price)}
                  variant={
                    if product.price == nil, do: :neutral, else: :success
                  }
                />
              </span>
            </:meta>
            <:content>
              <div
                id={"products-#{product.id}-preview"}
                class="flex flex-col gap-4"
              >
                <div class="flex min-w-0 flex-col gap-4 sm:flex-row sm:items-start">
                  <div class="h-24 w-24 shrink-0 overflow-hidden rounded-lg bg-zinc-200 dark:bg-zinc-800">
                    <img
                      :if={product.img_url != nil}
                      src={product.img_url}
                      alt={gettext("%{name} image", name: product.name)}
                      class="h-full w-full object-cover"
                    />
                  </div>

                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
                      <%= gettext("Last Price") %>
                    </p>
                    <p class="mt-1 text-2xl font-semibold text-zinc-800 dark:text-zinc-100">
                      <%= product_price(product.price) %>
                    </p>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                      <%= gettext("Last updated") %> · <%= TimeAgo.time_ago(
                        product.price_updated_at
                      ) %>
                    </p>

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <.render_ean
                        ean={product.ean || gettext("Unassigned")}
                        has_code={product.ean != nil}
                      />
                      <a
                        :if={product.supplier_url != nil}
                        href={product.supplier_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-sm text-zinc-600 hover:text-sky-500 dark:text-zinc-300"
                      >
                        <.icon name="hero-link-solid" class="h-4 w-4" />
                        <%= gettext("Open") %>
                      </a>
                    </div>
                  </div>

                  <div class="flex shrink-0 flex-row items-center gap-2">
                    <.link
                      id={"products-analytics-#{product.id}"}
                      navigate={
                        ~p"/admin/marketplaces/products/#{product}/show"
                      }
                      class="inline-flex items-center justify-center rounded-lg py-2 px-3 text-sm font-semibold bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700"
                    >
                      <.icon name="hero-chart-bar-solid" class="h-4 w-4" />
                      <span class="sr-only">
                        <%= gettext("Analytics") %>
                      </span>
                    </.link>
                    <.button
                      :if={can_delete_products?(@current_user)}
                      id={"products-delete-#{product.id}"}
                      type="button"
                      phx-click={
                        JS.push("delete", value: %{id: product.id})
                        |> hide("#products-#{product.id}")
                      }
                      data-confirm={
                        gettext("Delete product \"%{name}\"?",
                          name: product.name
                        )
                      }
                      class="bg-rose-100 text-rose-700 hover:bg-rose-200 dark:bg-rose-900/40 dark:text-rose-300 dark:hover:bg-rose-900/70"
                    >
                      <.icon name="hero-trash-solid" class="h-4 w-4" />
                      <span class="sr-only"><%= gettext("Delete") %></span>
                    </.button>
                  </div>
                </div>

                <div
                  :if={can_edit_products?(@current_user)}
                  id={"products-edit-form-#{product.id}"}
                >
                  <.live_component
                    module={
                      PriceSpotterWeb.Admin.Marketplaces.ProductLive.FormComponent
                    }
                    id={"product-inline-edit-#{product.id}"}
                    title={gettext("Edit Product")}
                    action={:edit}
                    variant={:inline}
                    product={product}
                    form_id={"product-form-#{product.id}"}
                    patch={products_index_path(@meta)}
                  />
                </div>
              </div>
            </:content>
          </.expandable_list_row>
        </:row>
      </.list_group>

      <div class="flex justify-center w-full my-4">
        <Flop.Phoenix.cursor_pagination
          meta={@meta}
          path={~p"/admin/marketplaces/products"}
        />
      </div>
    <% end %>
  </div>

  <.modal
    :if={@live_action == :new}
    id="product-modal"
    show
    on_cancel={JS.patch(products_index_path(@meta))}
  >
    <.live_component
      module={PriceSpotterWeb.Admin.Marketplaces.ProductLive.FormComponent}
      id={@product.id || :new}
      title={@page_title}
      action={@live_action}
      product={@product}
      patch={products_index_path(@meta)}
    />
  </.modal>
</div>
