<.header>
  <%= @supplier.name %>
  <:subtitle>
    <span id="supplier-subscribed" class="inline-flex items-center gap-2">
      <%= gettext("Subscribed") %>
      <.icon
        :if={@subscribed? == true}
        name="hero-check-circle-solid"
        class="h-5 w-5 text-emerald-600 dark:text-emerald-400"
      />
      <span :if={@subscribed? == true} class="sr-only">
        <%= gettext("Yes") %>
      </span>
      <.icon
        :if={@subscribed? == false}
        name="hero-x-circle-solid"
        class="h-5 w-5 text-rose-600 dark:text-rose-400"
      />
      <span :if={@subscribed? == false} class="sr-only">
        <%= gettext("No") %>
      </span>
    </span>
  </:subtitle>
  <:actions>
    <.link
      :if={Accounts.can_edit_suppliers?(@current_user)}
      patch={~p"/admin/marketplaces/suppliers/#{@supplier}/show/edit"}
      phx-click={JS.push_focus()}
    >
      <.button><%= gettext("Edit supplier") %></.button>
    </.link>
  </:actions>
</.header>

<.back navigate={~p"/admin/marketplaces/suppliers"}>
  <%= gettext("Back to suppliers") %>
</.back>

<.modal
  :if={@live_action == :edit}
  id="supplier-modal"
  show
  on_cancel={JS.patch(~p"/admin/marketplaces/suppliers/#{@supplier}")}
>
  <.live_component
    module={PriceSpotterWeb.Admin.Marketplaces.SupplierLive.FormComponent}
    id={@supplier.id}
    title={@page_title}
    action={@live_action}
    supplier={@supplier}
    patch={~p"/admin/marketplaces/suppliers/#{@supplier}"}
  />
</.modal>
