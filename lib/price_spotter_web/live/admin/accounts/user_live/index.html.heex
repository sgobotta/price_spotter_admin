<.header>
  <%= gettext("Users") %>
  <:actions>
    <.link patch={~p"/admin/accounts/users/new"}>
      <.button><%= gettext("New User") %></.button>
    </.link>
  </:actions>
</.header>

<div class="my-4">
  <.filter_form id="users-filter-form" meta={@meta} fields={@filter_fields} />
</div>

<%= if @users && @meta do %>
  <.list_header meta={@meta} path={~p"/admin/accounts/users"}>
    <:col field={:email} label={gettext("Email")} class="flex-1" />
    <:col label={gettext("Role")} />
  </.list_header>

  <.list_group id="users" items={@users}>
    <:empty_state>
      <.no_results_found label={gettext("No users found.")} />
    </:empty_state>
    <:row :let={user}>
      <.expandable_list_row
        id={"users-#{user.id}"}
        expanded={ExpandableList.expanded?(@expanded, user.id)}
        toggle_key={user.id}
      >
        <:leading>
          <.entity_avatar label={user.email} />
        </:leading>
        <:title><%= user.email %></:title>
        <:meta>
          <.pill
            text={role_label(user.role)}
            variant={if user.role == :admin, do: :info, else: :neutral}
          />
        </:meta>
        <:actions>
          <.button
            id={"users-delete-#{user.id}"}
            type="button"
            phx-click="prompt_delete"
            phx-value-id={user.id}
            class="bg-rose-100 text-rose-700 hover:bg-rose-200 dark:bg-rose-900/40 dark:text-rose-300 dark:hover:bg-rose-900/70"
          >
            <.icon name="hero-trash-solid" class="h-4 w-4" />
            <span class="sr-only"><%= gettext("Delete") %></span>
          </.button>
        </:actions>
        <:content>
          <div class="space-y-6">
            <.live_component
              module={PriceSpotterWeb.Admin.Accounts.UserLive.FormComponent}
              id={"user-edit-#{user.id}"}
              title={gettext("Edit User")}
              action={:edit}
              user={user}
              patch={~p"/admin/accounts/users"}
              form_id={"user-form-#{user.id}"}
            />

            <div
              :if={@current_user.role == :admin}
              class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-700"
            >
              <.live_component
                module={
                  PriceSpotterWeb.Admin.Accounts.UserLive.CustomerAccessComponent
                }
                id={"customer-access-#{user.id}"}
                user={user}
                form_id={"customer-access-form-#{user.id}"}
              />
            </div>
          </div>
        </:content>
      </.expandable_list_row>
    </:row>
  </.list_group>

  <div class="my-4 flex w-full justify-center">
    <Flop.Phoenix.cursor_pagination
      meta={@meta}
      path={~p"/admin/accounts/users"}
    />
  </div>
<% end %>

<.modal
  :if={@live_action == :new}
  id="user-modal"
  show
  on_cancel={JS.patch(~p"/admin/accounts/users")}
>
  <.live_component
    module={PriceSpotterWeb.Admin.Accounts.UserLive.FormComponent}
    id={@user.id || :new}
    title={@page_title}
    action={@live_action}
    user={@user}
    patch={~p"/admin/accounts/users"}
  />
</.modal>

<.modal
  :if={@delete_user != nil}
  id="delete-user-modal"
  show
  on_cancel={JS.push("cancel_delete")}
>
  <div class="space-y-6">
    <.header>
      <%= gettext("Delete user") %>
      <:subtitle>
        <%= gettext("Delete user \"%{name}\"?", name: @delete_user.email) %>
      </:subtitle>
    </.header>

    <div class="flex items-center justify-end gap-3">
      <.button
        type="button"
        phx-click="cancel_delete"
        class="bg-zinc-100 text-zinc-700 hover:bg-zinc-200 dark:bg-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-600"
      >
        <%= gettext("Cancel") %>
      </.button>
      <.button
        type="button"
        phx-click="delete"
        phx-value-id={@delete_user.id}
        class="bg-rose-600 text-zinc-100 hover:bg-rose-500"
      >
        <%= gettext("Delete") %>
      </.button>
    </div>
  </div>
</.modal>
