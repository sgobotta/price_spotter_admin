<.header>
  <%= gettext("Users") %>
  <:actions>
    <.link patch={~p"/admin/accounts/users/new"}>
      <.button><%= gettext("New User") %></.button>
    </.link>
  </:actions>
</.header>

<div class="my-4">
  <.filter_form id="users-filter-form" meta={@meta} fields={@filter_fields} />
</div>

<%= if @users && @meta do %>
  <.list_header meta={@meta} path={~p"/admin/accounts/users"}>
    <:col field={:email} label={gettext("Email")} class="flex-1" />
    <:col label={gettext("Role")} />
  </.list_header>

  <.list_group id="users" items={@users}>
    <:empty_state>
      <.no_results_found label={gettext("No users found.")} />
    </:empty_state>
    <:row :let={user}>
      <.list_row
        id={"users-#{user.id}"}
        click={JS.navigate(~p"/admin/accounts/users/#{user}")}
      >
        <:leading>
          <.entity_avatar label={user.email} />
        </:leading>
        <:title><%= user.email %></:title>
        <:meta>
          <.pill
            text={role_label(user.role)}
            variant={if user.role == :admin, do: :info, else: :neutral}
          />
        </:meta>
        <:actions>
          <.link navigate={~p"/admin/accounts/users/#{user}"} class="sr-only">
            <%= gettext("Show") %>
          </.link>
          <.link
            id={"users-edit-#{user.id}"}
            patch={~p"/admin/accounts/users/#{user}/edit"}
            class="hover:text-teal-500"
          >
            <.icon
              name="hero-pencil-solid"
              class="h-3 w-3 sm:h-5 sm:w-5 opacity-60"
            />
          </.link>
          <.link
            id={"users-delete-#{user.id}"}
            phx-click={
              JS.push("delete", value: %{id: user.id})
              |> hide("#users-#{user.id}")
            }
            data-confirm={gettext("Delete user \"%{name}\"?", name: user.email)}
            class="hover:text-rose-500"
          >
            <.icon
              name="hero-trash-solid"
              class="h-3 w-3 sm:h-5 sm:w-5 opacity-60"
            />
          </.link>
        </:actions>
      </.list_row>
    </:row>
  </.list_group>

  <div class="my-4 flex w-full justify-center">
    <Flop.Phoenix.cursor_pagination
      meta={@meta}
      path={~p"/admin/accounts/users"}
    />
  </div>
<% end %>

<.modal
  :if={@live_action in [:new, :edit]}
  id="user-modal"
  show
  on_cancel={JS.patch(~p"/admin/accounts/users")}
>
  <.live_component
    module={PriceSpotterWeb.Admin.Accounts.UserLive.FormComponent}
    id={@user.id || :new}
    title={@page_title}
    action={@live_action}
    user={@user}
    patch={~p"/admin/accounts/users"}
  />
</.modal>
