<!DOCTYPE html>
<html lang="en" class="overscroll-none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Price Spotter">
      <%= assigns[:page_title] || "Price Spotter" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
    >
    </script>
  </head>
  <body class="overscroll-none main-bg antialiased text-black dark:text-white">
    <ul
      :if={!@current_user}
      class="
        relative z-10
        flex items-center
        gap-4 justify-end
        border-r-[1px] border-l-[1px] border-dotted
        border-zinc-300 dark:border-zinc-700
      "
    >
      <li>
        <.link
          href={~p"/users/register"}
          class="text-[0.8125rem] leading-6 text-zinc-900 dark:text-zinc-100 font-semibold hover:text-zinc-700 hover:dark:text-zinc-200"
        >
          <%= gettext("Register") %>
        </.link>
      </li>
      <li>
        <.link
          href={~p"/users/log_in"}
          class="text-[0.8125rem] leading-6 text-zinc-900 dark:text-zinc-100 font-semibold hover:text-zinc-700 hover:dark:text-zinc-200"
        >
          <%= gettext("Log in") %>
        </.link>
      </li>
    </ul>
    <%= @inner_content %>
  </body>
</html>
